specialModules.ReplayMod = function(UI)
	local mod = UI:AddTab("Replay Mod")

	local player = game.Players.LocalPlayer
	local RunService = game:GetService("RunService")

	local recording = false
	local replaying = false

	local frames = {}
	local animEvents = {}

	local startCFrame = nil

	local recordConn
	local replayConn

	local recordRate = 1/30
	local lastRecord = 0

	mod:AddToggle("Recording", function(v)
		recording = v

		if recording then
			frames = {}
			animEvents = {}

			local char = player.Character
			if not char then return end

			local hrp = char:WaitForChild("HumanoidRootPart")
			local humanoid = char:WaitForChild("Humanoid")
			local animator = humanoid:FindFirstChildOfClass("Animator")

			startCFrame = hrp.CFrame
			lastRecord = 0

			local activeTracks = {}

			if animator then
				animator.AnimationPlayed:Connect(function(track)
					table.insert(animEvents, {
						t = tick(),
						type = "play",
						id = track.Animation.AnimationId,
						time = track.TimePosition
					})

					activeTracks[track] = true

					track.Stopped:Connect(function()
						table.insert(animEvents, {
							t = tick(),
							type = "stop",
							id = track.Animation.AnimationId
						})

						activeTracks[track] = nil
					end)
				end)
			end

			recordConn = RunService.Heartbeat:Connect(function(dt)
				lastRecord += dt

				if lastRecord >= recordRate then
					lastRecord = 0

					table.insert(frames, {
						t = tick(),
						cf = hrp.CFrame
					})
				end
			end)

		else
			if recordConn then
				recordConn:Disconnect()
			end
		end
	end)
	
	
	local animationCache = {}

	mod:AddButton("Play Replay", function()
		if #frames < 2 then return end

		local char = player.Character
		if not char then return end

		local hrp = char:WaitForChild("HumanoidRootPart")
		local humanoid = char:WaitForChild("Humanoid")
		local animator = humanoid:FindFirstChildOfClass("Animator")

		replaying = true

		hrp.CFrame = startCFrame
		humanoid.PlatformStand = true

		local playingTracks = {}

		local function getTrack(animator, id)

			if animationCache[id] then
				return animationCache[id]
			end

			local anim = Instance.new("Animation")
			anim.AnimationId = id

			local track = animator:LoadAnimation(anim)
			animationCache[id] = track

			return track
		end

		local function playAnimation(id, startTime)
			local track = getTrack(animator, id)

			if track.IsPlaying then return end

			track:Play()
			track.TimePosition = startTime or 0
		end

		local function stopAnimation(id)
			local track = animationCache[id]
			if track then
				track:Stop(0)
			end
		end


		table.sort(animEvents, function(a, b)
			return a.t < b.t
		end)

		local animIndex = 1


		local startTime = tick()
		local i = 1
		
		local hrp = char:WaitForChild("HumanoidRootPart")

		local function freezeVelocity()
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
		
		workspace.CurrentCamera.CameraSubject = char.Head
	
		replayConn = RunService.RenderStepped:Connect(function()
			if not replaying then return end
			
			local function stopAllAnimations()
				local animator = humanoid:FindFirstChildOfClass("Animator")

				for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
					t:Stop()
				end
				table.clear(playingTracks)
			end
			
			local currentTime = tick() - startTime
			
			
			freezeVelocity()
			while i < #frames and frames[i+1].t - frames[1].t <= currentTime do
				i += 1
			end

			local f1 = frames[i]
			local f2 = frames[i+1]

			if not f2 then
				replaying = false
				replayConn:Disconnect()

				humanoid.PlatformStand = false

				stopAllAnimations()
				workspace.CurrentCamera.CameraSubject = char.Humanoid
				
				table.clear(animationCache)
				table.clear(playingTracks)

				return
			end

			local t1 = f1.t - frames[1].t
			local t2 = f2.t - frames[1].t

			local alpha = math.clamp((currentTime - t1) / (t2 - t1), 0, 1)

			hrp.CFrame = f1.cf:Lerp(f2.cf, alpha)

			while animIndex <= #animEvents and animEvents[animIndex].t - frames[1].t <= currentTime do
				local ev = animEvents[animIndex]

				if ev.type == "play" then
					playAnimation(ev.id, ev.time)
				elseif ev.type == "stop" then
					stopAnimation(ev.id)
				end

				animIndex += 1
			end
			
			
			
		end)
	end)
end

specialModules.BuildTools = function(UI)
	local tab = UI:AddTab("Building Tools")

	local player = game.Players.LocalPlayer
	local mouse = player:GetMouse()
	local RunService = game:GetService("RunService")

	local buildMode = false
	local deleteMode = false

	local gridSize = 4
	local selectedColor = Color3.fromRGB(255,255,255)
	local selectedSize = Vector3.new(4,4,4)

	local function snap(v)
		return Vector3.new(
			math.floor(v.X / gridSize + 0.5) * gridSize,
			math.floor(v.Y / gridSize + 0.5) * gridSize,
			math.floor(v.Z / gridSize + 0.5) * gridSize
		)
	end

	local function placePart()
		local char = player.Character
		if not char then return end

		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local part = Instance.new("Part")
		part.Size = selectedSize
		part.Anchored = true
		part.Color = selectedColor
		part.Material = Enum.Material.SmoothPlastic

		local pos = mouse.Hit.Position
		part.Position = snap(pos)

		part.Parent = workspace
	end

	local function deletePart()
		local target = mouse.Target
		if target and target:IsA("BasePart") then
			target:Destroy()
		end
	end

	tab:AddToggle("Build Mode", function(v)
		buildMode = v
	end)

	tab:AddToggle("Delete Mode", function(v)
		deleteMode = v
	end)

	mouse.Button1Down:Connect(function()
		if buildMode then
			placePart()
		elseif deleteMode then
			deletePart()
		end
	end)

	local r, g, b = 255, 255, 255

	local function updateColor()
		selectedColor = Color3.fromRGB(r, g, b)
	end

	tab:AddLabel("Color Picker", {Bold = true, Size = 16})

	tab:AddSlider("Red", 0, 255, 255, function(v)
		r = math.floor(v)
		updateColor()
	end)

	tab:AddSlider("Green", 0, 255, 255, function(v)
		g = math.floor(v)
		updateColor()
	end)

	tab:AddSlider("Blue", 0, 255, 255, function(v)
		b = math.floor(v)
		updateColor()
	end)

	tab:AddSlider("Part Size", 1, 20, 4, function(v)
		selectedSize = Vector3.new(v, v, v)
	end)

	tab:AddSlider("Grid Size", 1, 20, 4, function(v)
		gridSize = v
	end)

	tab:AddButton("Block", function()
		selectedSize = Vector3.new(4,4,4)
	end)

	tab:AddButton("Floor", function()
		selectedSize = Vector3.new(20,1,20)
	end)

	tab:AddButton("Wall", function()
		selectedSize = Vector3.new(20,10,1)
	end)

	local rotation = 0

	tab:AddSlider("Rotation Y", 0, 360, 0, function(v)
		rotation = v
	end)

	local oldPlace = placePart
	placePart = function()
		local char = player.Character
		if not char then return end

		local part = Instance.new("Part")
		part.Size = selectedSize
		part.Anchored = true
		part.Color = selectedColor
		part.Material = Enum.Material.SmoothPlastic

		part.CFrame =
			CFrame.new(snap(mouse.Hit.Position)) *
			CFrame.Angles(0, math.rad(rotation), 0)

		part.Parent = workspace
	end
end








