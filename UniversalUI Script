specialModules.ExtraMovement = function(UI)
	local emmTab = UI:AddTab("Extra Movement")
	
	local sprintEnabled = false
	local sprintToggle = emmTab:AddToggle("Sprint", function(v)
		sprintEnabled = v
	end)
	
	local sprinting = false
	
	game:GetService("UserInputService").InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.LeftShift then
			sprinting = true
		end
	end)
	
	game:GetService("UserInputService").InputEnded:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.LeftShift then
			sprinting = false
		end
	end)
	
	local sl = player.DevEnableMouseLock
	task.spawn(function()
	while task.wait() do
		if sprintEnabled then
			if sprinting then
				if player.Character and player.Character:FindFirstChild("Humanoid") then
					player.Character.Humanoid.WalkSpeed = 32
				end
			else
				if player.Character and player.Character:FindFirstChild("Humanoid") then
					player.Character.Humanoid.WalkSpeed = 16
				end
			end
		else
		end
	end
	end)
	
	local UIS = game:GetService("UserInputService")

	local jumpCount = 0
	local maxJumps = 2
	local debounce = false

	local function setupCharacter(char)
		local humanoid = char:WaitForChild("Humanoid")

		jumpCount = 0

		humanoid.StateChanged:Connect(function(old, new)
			if new == Enum.HumanoidStateType.Landed then
				jumpCount = 0
				debounce = false
			end
		end)
	end

	if player.Character then
		setupCharacter(player.Character)
	end
	player.CharacterAdded:Connect(setupCharacter)
	
	local canDoubleJump = false
	
	local doubleJumpToggle = emmTab:AddToggle("Double Jump", function(v)
		canDoubleJump = v
	end)
	
	local jumpHeld = false

	UIS.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.Space then
			jumpHeld = true
		end
	end)

	UIS.InputEnded:Connect(function(input, gpe)
		if input.KeyCode == Enum.KeyCode.Space then
			jumpHeld = false
		end
	end)
	
	local jumpSlider = emmTab:AddSlider("Extra Jump Count", 0, 10, 2, function(v)
		maxJumps = v
	end)
	
	UIS.JumpRequest:Connect(function()
		if canDoubleJump then
		local char = player.Character
		if not char then return end

		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
			if humanoid.FloorMaterial ~= Enum.Material.Air then
				debounce = true

				repeat task.wait() until not jumpHeld

				debounce = false
			else
		if jumpCount < maxJumps - 1 and not debounce then
			debounce = true
			jumpCount += 1

			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

			task.delay(0.1, function()
				debounce = false
			end)
		end
		end
		end
	end)
end

