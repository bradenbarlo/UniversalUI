tab3:AddToggle("Zoom",function(enabled)
	local camera = workspace.CurrentCamera
	local player = game.Players.LocalPlayer

	if enabled then
		local originalFOV = camera.FieldOfView
		local originalMinZoom = player.CameraMinZoomDistance
		local originalMaxZoom = player.CameraMaxZoomDistance

		player:SetAttribute("ZoomFOV", originalFOV)
		player:SetAttribute("ZoomMin", originalMinZoom)
		player:SetAttribute("ZoomMax", originalMaxZoom)

		player.CameraMinZoomDistance = 0
		player.CameraMaxZoomDistance = 0

		local targetFOV = originalFOV
		local minFOV = 20
		local maxFOV = 100
		local zoomSpeed = 2

		zoomInputConnection = UIS.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				targetFOV = math.clamp(targetFOV - (input.Position.Z * zoomSpeed), minFOV, maxFOV)
			end
		end)

		local RunService = game:GetService("RunService")
		zoomConnection = RunService.RenderStepped:Connect(function()
			camera.FieldOfView = camera.FieldOfView + (targetFOV - camera.FieldOfView) * 0.2
		end)

	else
		local originalFOV = player:GetAttribute("ZoomFOV")
		local originalMinZoom = player:GetAttribute("ZoomMin")
		local originalMaxZoom = player:GetAttribute("ZoomMax")

		if zoomConnection then
			zoomConnection:Disconnect()
			zoomConnection = nil
		end

		if zoomInputConnection then
			zoomInputConnection:Disconnect()
			zoomInputConnection = nil
		end

		if originalFOV then
			camera.FieldOfView = originalFOV
		end

		if originalMinZoom and originalMaxZoom then
			player.CameraMinZoomDistance = originalMinZoom
			player.CameraMaxZoomDistance = originalMaxZoom
		end
	end
end, Enum.KeyCode.Z)

