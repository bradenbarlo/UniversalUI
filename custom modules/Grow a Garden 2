return function(UI)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local player = Players.LocalPlayer

	local Networking = require(
		ReplicatedStorage.SharedModules.Networking
	)

	-- Tabs
	local gagTab = UI:AddTab("Grow a Garden 2")
	
	
	
	local seedDropdown = gagTab:AddDropdown("Seeds", true)
	local gearDropdown = gagTab:AddDropdown("Gears", true)
	local crateDropdown = gagTab:AddDropdown("Crates", true)

	local enabledSeeds = {}
	local enabledGears = {}
	local enabledCrates = {}

	--------------------------------------------------
	-- Seeds
	--------------------------------------------------

	local seedShop = player.PlayerGui:WaitForChild("SeedShop")
	local normalShop = seedShop.Frame.NormalShop

	for _, seedFrame in ipairs(normalShop:GetChildren()) do
		if seedFrame:IsA("Frame") or seedFrame:IsA("ImageLabel") then
			if not seedFrame:FindFirstChild("Main_Frame") then continue end
			if not seedFrame.Main_Frame:FindFirstChild("Seed_Text") then continue end
			if seedFrame.Name == "ItemTemplate" then continue end
			
			if seedFrame.Name == "Robux_Shelf" then continue end
			if seedFrame.Name == "Sheckles_Shelf" then continue end
			
			local seedName = seedFrame.Name

			enabledSeeds[seedName] = false

			seedDropdown:AddToggle(seedName, function(state)
				enabledSeeds[seedName] = state
			end)
		end
	end

	--------------------------------------------------
	-- Gears
	--------------------------------------------------

	local gearShop = player.PlayerGui:WaitForChild("GearShop")
	local gearScroll = gearShop.Frame:FindFirstChild("ScrollingFrame")

	if gearScroll then
		for _, gearFrame in ipairs(gearScroll:GetChildren()) do
			if not gearFrame:IsA("Frame") and not gearFrame:IsA("ImageLabel") then
				continue
			end

			if gearFrame.Name == "ItemTemplate" then
				continue
			end
			
			if gearFrame.Name == "Robux_Shelf" then continue end
			if gearFrame.Name == "Sheckles_Shelf" then continue end

			if not gearFrame:FindFirstChild("Main_Frame") then
				continue
			end

			local gearName = gearFrame.Name

			enabledGears[gearName] = false

			gearDropdown:AddToggle(gearName, function(state)
				enabledGears[gearName] = state
			end)
		end
	end

	--------------------------------------------------
	-- Crates
	--------------------------------------------------

	local crateShop = player.PlayerGui:WaitForChild("CrateShop")
	local crateScroll = crateShop.Frame:FindFirstChild("ScrollingFrame")

	if crateScroll then
		for _, crateFrame in ipairs(crateScroll:GetChildren()) do
			if not crateFrame:IsA("Frame") and not crateFrame:IsA("ImageLabel") then
				continue
			end

			if crateFrame.Name == "ItemTemplate" then
				continue
			end
			
			if crateFrame.Name == "Robux_Shelf" then continue end
			if crateFrame.Name == "Sheckles_Shelf" then continue end

			if not crateFrame:FindFirstChild("Main_Frame") then
				continue
			end

			local crateName = crateFrame.Name

			enabledCrates[crateName] = false

			crateDropdown:AddToggle(crateName, function(state)
				enabledCrates[crateName] = state
			end)
		end
	end

	--------------------------------------------------
	-- Auto Buy Loop
	--------------------------------------------------


	
	local antiAfkEnabled = false

	gagTab:AddToggle("Anti AFK", function(state)
		antiAfkEnabled = state
	end)

	task.spawn(function()
		local VirtualUser = game:GetService("VirtualUser")

		while task.wait(300) do -- 5 minutes
			if antiAfkEnabled then
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new())
			end
		end
	end)
	
	local webhookUrl = ""

	gagTab:AddInput("Discord Webhook", function(text)
		webhookUrl = text
	end)
	
	local HttpService = game:GetService("HttpService")

	local request =
		syn and syn.request
		or http_request
		or request

	local function sendWebhook(seeds, gears, crates)
		if webhookUrl == "" or not request then
			return
		end

		local now = os.date("%Y-%m-%d %H:%M:%S")

		local embed = {
			title = "🌱 Grow a Garden Auto Buyer",
			description = "Items purchased during latest restock",
			color = 65280,

			fields = {
				{
					name = "🌾 Seeds",
					value = #seeds > 0 and table.concat(seeds, "\n") or "None"
				},
				{
					name = "⚙️ Gears",
					value = #gears > 0 and table.concat(gears, "\n") or "None"
				},
				{
					name = "📦 Crates",
					value = #crates > 0 and table.concat(crates, "\n") or "None"
				},
				{
					name = "🕒 Time",
					value = os.date("%I:%M:%S %p")
				},
				{
					name = "📅 Date",
					value = os.date("%Y-%m-%d")
				}
			},

			footer = {
				text = player.Name
			},

			timestamp = DateTime.now():ToIsoDate()
		}

		request({
			Url = webhookUrl,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = HttpService:JSONEncode({
				embeds = {embed}
			})
		})
	end
	
	task.spawn(function()
		local boughtSeeds = {}
		local boughtGears = {}
		local boughtCrates = {}

		local seedCooldown = {}
		local gearCooldown = {}
		local crateCooldown = {}

		local COOLDOWN = 0.05
		local WEBHOOK_COOLDOWN = 2
		local lastWebhookTime = 0

		local sendingWebhook = false -- 🔥 HARD LOCK

		local function addCount(map, item)
			map[item] = (map[item] or 0) + 1
		end

		local function formatList(map)
			local result = {}

			for item, count in pairs(map) do
				if count > 1 then
					table.insert(result, item .. " x" .. count)
				else
					table.insert(result, item)
				end
			end

			return table.concat(result, "\n")
		end

		while true do
			local now = os.clock()

			--------------------------------------------------
			-- SEEDS
			--------------------------------------------------
			for seedName, enabled in pairs(enabledSeeds) do
				if enabled then
					local last = seedCooldown[seedName] or 0

					if now - last >= COOLDOWN then
						seedCooldown[seedName] = now

						local frame = normalShop:FindFirstChild(seedName)

						if frame
							and frame:FindFirstChild("Main_Frame")
							and frame.Main_Frame:FindFirstChild("Stock_Text")
							and frame.Main_Frame.Stock_Text.Text ~= "x0 in Stock" then

							pcall(function()
								Networking.SeedShop.PurchaseSeed:Fire(seedName)
							end)

							addCount(boughtSeeds, seedName)
						end
					end
				end
			end

			--------------------------------------------------
			-- GEARS
			--------------------------------------------------
			for gearName, enabled in pairs(enabledGears) do
				if enabled then
					local last = gearCooldown[gearName] or 0

					if now - last >= COOLDOWN then
						gearCooldown[gearName] = now

						local frame = gearScroll:FindFirstChild(gearName)

						if frame
							and frame:FindFirstChild("Main_Frame")
							and frame.Main_Frame:FindFirstChild("Stock_Text")
							and frame.Main_Frame.Stock_Text.Text ~= "x0 in Stock" then

							pcall(function()
								Networking.GearShop.PurchaseGear:Fire(gearName)
							end)

							addCount(boughtGears, gearName)
						end
					end
				end
			end

			--------------------------------------------------
			-- CRATES
			--------------------------------------------------
			for crateName, enabled in pairs(enabledCrates) do
				if enabled then
					local last = crateCooldown[crateName] or 0

					if now - last >= COOLDOWN then
						crateCooldown[crateName] = now

						local frame = crateScroll:FindFirstChild(crateName)

						if frame
							and frame:FindFirstChild("Main_Frame")
							and frame.Main_Frame:FindFirstChild("Stock_Text")
							and frame.Main_Frame.Stock_Text.Text ~= "x0 in Stock" then

							pcall(function()
								Networking.CrateShop.PurchaseCrate:Fire(crateName)
							end)

							addCount(boughtCrates, crateName)
						end
					end
				end
			end

			--------------------------------------------------
			-- WEBHOOK (LOCKED - NO DOUBLE FIRE)
			--------------------------------------------------
			local hasAny =
				next(boughtSeeds) ~= nil
				or next(boughtGears) ~= nil
				or next(boughtCrates) ~= nil

			if hasAny
				and not sendingWebhook
				and (now - lastWebhookTime >= WEBHOOK_COOLDOWN) then

				sendingWebhook = true -- 🔥 LOCK

				lastWebhookTime = now

				sendWebhook(
					boughtSeeds,
					boughtGears,
					boughtCrates
				)

				-- reset AFTER send
				boughtSeeds = {}
				boughtGears = {}
				boughtCrates = {}

				task.wait(WEBHOOK_COOLDOWN)

				sendingWebhook = false -- unlock
			end

			task.wait(0.1)
		end
	end)
	
	
	
end
