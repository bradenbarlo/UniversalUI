return function(UI)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local player = Players.LocalPlayer

	local Networking = require(
		ReplicatedStorage.SharedModules.Networking
	)

	local seedTab = UI:AddTab("Auto Seeds")

	local enabledSeeds = {}

	local function isSeedFrame(obj)
		return obj:IsA("GuiObject")
			and obj:FindFirstChild("Main_Frame")
			and obj.Main_Frame:FindFirstChild("Buttons")
			and obj.Main_Frame.Buttons:FindFirstChild("Sheckles")
	end

	local shop = player.PlayerGui:WaitForChild("SeedShop")
	local normalShop = shop.Frame.NormalShop

	for _, seedFrame in ipairs(normalShop:GetChildren()) do
		if isSeedFrame(seedFrame) then
			local seedName = seedFrame.Name

			enabledSeeds[seedName] = false

			seedTab:AddToggle(seedName, function(state)
				enabledSeeds[seedName] = state
			end)
		end
	end

	task.spawn(function()
		while task.wait(0.5) do
			for seedName, enabled in pairs(enabledSeeds) do
				if enabled then
					local seedFrame = normalShop:FindFirstChild(seedName)

					if seedFrame
						and seedFrame:FindFirstChild("Main_Frame")
						and seedFrame.Main_Frame:FindFirstChild("Buttons")
						and seedFrame.Main_Frame.Buttons:FindFirstChild("Sheckles") then

						local buyButton = seedFrame.Main_Frame.Buttons.Sheckles

						-- Only buy if currently stocked
						if buyButton.Visible
							and buyButton.Active
							and buyButton.Parent.Visible then

							pcall(function()
								Networking.SeedShop.PurchaseSeed:Fire(seedName)
							end)
						end
					end
				end
			end
		end
	end)

end
