return function(UI)

	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local player = Players.LocalPlayer

	local Networking = require(
		ReplicatedStorage.SharedModules.Networking
	)

	local seedTab = UI:AddTab("Auto Seeds")
	local seedDropdown = seedTab:AddDropdown("Seeds", true)

	local enabledSeeds = {}
	local createdToggles = {}

	local function addSeed(seedName)
		if createdToggles[seedName] then
			return
		end

		createdToggles[seedName] = true
		enabledSeeds[seedName] = false

		seedDropdown:AddToggle(seedName, function(state)
			enabledSeeds[seedName] = state
		end)
	end

	local function getNormalShop()
		local playerGui = player:FindFirstChild("PlayerGui")
		if not playerGui then
			return nil
		end

		local seedShop = playerGui:FindFirstChild("SeedShop")
		if not seedShop then
			return nil
		end

		local frame = seedShop:FindFirstChild("Frame")
		if not frame then
			return nil
		end

		return frame:FindFirstChild("NormalShop")
	end

	task.spawn(function()
		while task.wait(1) do
			local normalShop = getNormalShop()

			if normalShop then
				for _, child in ipairs(normalShop:GetChildren()) do
					if child:IsA("GuiObject") then
						local mainFrame = child:FindFirstChild("Main_Frame")

						if mainFrame then
							local buttons = mainFrame:FindFirstChild("Buttons")

							if buttons and buttons:FindFirstChild("Sheckles") then
								addSeed(child.Name)
							end
						end
					end
				end
			end
		end
	end)

	task.spawn(function()
		while task.wait(0.5) do
			local normalShop = getNormalShop()

			if not normalShop then
				continue
			end

			for seedName, enabled in pairs(enabledSeeds) do
				if not enabled then
					continue
				end

				local seedFrame = normalShop:FindFirstChild(seedName)

				if not seedFrame then
					continue
				end

				local mainFrame = seedFrame:FindFirstChild("Main_Frame")
				if not mainFrame then
					continue
				end

				local buttons = mainFrame:FindFirstChild("Buttons")
				if not buttons then
					continue
				end

				local buyButton = buttons:FindFirstChild("Sheckles")
				if not buyButton then
					continue
				end

				if buyButton.Visible then
					pcall(function()
						Networking.SeedShop.PurchaseSeed:Fire(seedName)
					end)
				end
			end
		end
	end)

end
