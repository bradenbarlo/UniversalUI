	function tab:AddToggle(text, callback, defaultKey)
		local holder = Instance.new("Frame", tabFrame)
		holder.Size = UDim2.new(1,0,0,40)
		holder.BackgroundColor3 = Color3.fromRGB(25,25,25)
		holder.BorderSizePixel = 0
		Instance.new("UICorner", holder).CornerRadius = UDim.new(0,8)

		table.insert(UI.Elements, {
			Instance = holder,
			Name = text:lower(),
			Tab = tabFrame
		})

		local label = Instance.new("TextLabel", holder)
		label.Text = text
		label.Size = UDim2.new(0.5,0,1,0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.new(1,1,1)
		label.TextXAlignment = Enum.TextXAlignment.Left

		local toggle = Instance.new("Frame", holder)
		toggle.Size = UDim2.new(0,40,0,20)
		toggle.Position = UDim2.new(1,-90,0.5,-10)
		toggle.BackgroundColor3 = Color3.fromRGB(50,50,50)
		Instance.new("UICorner", toggle).CornerRadius = UDim.new(1,0)

		local knob = Instance.new("Frame", toggle)
		knob.Size = UDim2.new(0,18,0,18)
		knob.Position = UDim2.new(0,1,0.5,-9)
		knob.BackgroundColor3 = Color3.new(1,1,1)
		Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

		local bindBtn = Instance.new("TextButton", holder)
		bindBtn.Size = UDim2.new(0,40,0,20)
		bindBtn.Position = UDim2.new(1,-45,0.5,-10)

		bindBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
		bindBtn.TextColor3 = Color3.new(1,1,1)
		bindBtn.BorderSizePixel = 0
		Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0,6)

		local state = false
		local binding = false
		local boundKey = defaultKey or nil

		if boundKey ~= nil then
			bindBtn.Text = defaultKey.Name
		else
			bindBtn.Text = "..."
		end

		local function setState(newState)
			state = newState
			knob.Position = state and UDim2.new(1,-19,0.5,-9) or UDim2.new(0,1,0.5,-9)
			toggle.BackgroundColor3 = state and Color3.fromRGB(0,170,255) or Color3.fromRGB(50,50,50)
			if callback then callback(state) end
		end

		holder.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and not binding then
				setState(not state)
			end
		end)

		bindBtn.MouseButton1Click:Connect(function()
			binding = true
			bindBtn.Text = "..."
			bindBtn.BackgroundColor3 = Color3.fromRGB(0,170,255)
		end)

		UIS.InputBegan:Connect(function(input, gpe)
			if gpe then return end

			if binding then
				if input.UserInputType == Enum.UserInputType.Keyboard then
					boundKey = input.KeyCode
					if boundKey then
						bindBtn.Text = boundKey.Name
					else
						bindBtn.Text = "..."
					end
					bindBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
					binding = false
				end
			else
				if boundKey and input.KeyCode == boundKey then
					setState(not state)
				end
			end
		end)

		return {
			Set = setState,
			Get = function() return state end,
			GetBind = function() return boundKey end
		}
	end

	function tab:AddButton(text, callback, defaultKey)
		local holder = Instance.new("Frame", tabFrame)
		holder.Size = UDim2.new(1,0,0,40)
		holder.BackgroundColor3 = Color3.fromRGB(25,25,25)
		holder.BorderSizePixel = 0
		Instance.new("UICorner", holder).CornerRadius = UDim.new(0,8)

		table.insert(UI.Elements, {
			Instance = holder,
			Name = text:lower(),
			Tab = tabFrame
		})

		local label = Instance.new("TextLabel", holder)
		label.Text = text
		label.Size = UDim2.new(0.6,0,1,0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.new(1,1,1)
		label.TextXAlignment = Enum.TextXAlignment.Left

		local pressBtn = Instance.new("TextButton", holder)
		pressBtn.Size = UDim2.new(0,70,0,20)
		pressBtn.Position = UDim2.new(1,-110,0.5,-10)
		pressBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
		pressBtn.TextColor3 = Color3.new(1,1,1)
		pressBtn.BorderSizePixel = 0
		pressBtn.Text = "Run"
		Instance.new("UICorner", pressBtn).CornerRadius = UDim.new(0,6)

		local bindBtn = Instance.new("TextButton", holder)
		bindBtn.Size = UDim2.new(0,40,0,20)
		bindBtn.Position = UDim2.new(1,-45,0.5,-10)
		bindBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
		bindBtn.TextColor3 = Color3.new(1,1,1)
		bindBtn.BorderSizePixel = 0
		bindBtn.Text = defaultKey and defaultKey.Name or "..."
		Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0,6)

		local boundKey = defaultKey or nil
		local binding = false

		local function run()
			if callback then
				callback()
			end
		end

		pressBtn.MouseButton1Click:Connect(run)

		bindBtn.MouseButton1Click:Connect(function()
			binding = true
			bindBtn.Text = "..."
			bindBtn.BackgroundColor3 = Color3.fromRGB(0,170,255)
		end)

		UIS.InputBegan:Connect(function(input, gpe)
			if gpe then return end

			if binding then
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.MouseButton2 then

					boundKey = nil
					bindBtn.Text = "..."
					bindBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
					binding = false
					return
				end

				if input.UserInputType == Enum.UserInputType.Keyboard then
					boundKey = input.KeyCode
					bindBtn.Text = boundKey.Name
					bindBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
					binding = false
				end
			else
				if boundKey and input.KeyCode == boundKey then
					run()
				end
			end
		end)

		return {
			Run = run,
			GetBind = function() return boundKey end,
			SetBind = function(k)
				boundKey = k
				bindBtn.Text = k and k.Name or "..."
			end
		}
	end




	function tab:AddLabel(text, options)
		options = options or {}

		local holder = Instance.new("Frame", tabFrame)
		holder.Size = UDim2.new(1,0,0, options.Height or 30)
		holder.BackgroundTransparency = 1

		local label = Instance.new("TextLabel", holder)
		label.Size = UDim2.new(1,0,1,0)
		label.BackgroundTransparency = 1

		label.Text = text or "Label"
		label.TextColor3 = options.Color or Color3.new(1,1,1)
		label.TextSize = options.Size or 14
		label.TextWrapped = options.Wrap or true

		if options.Alignment == "center" then
			label.TextXAlignment = Enum.TextXAlignment.Center
		elseif options.Alignment == "right" then
			label.TextXAlignment = Enum.TextXAlignment.Right
		else
			label.TextXAlignment = Enum.TextXAlignment.Left
		end

		if options.Bold and options.Italic then
			label.Font = Enum.Font.GothamBold
		elseif options.Bold then
			label.Font = Enum.Font.GothamBold
		elseif options.Italic then
			label.Font = Enum.Font.Gotham
		else
			label.Font = Enum.Font.Gotham
		end

		return label
	end

	function tab:AddSlider(text, min, max, default, callback)
		local holder = Instance.new("Frame", tabFrame)
		holder.Size = UDim2.new(1,-10,0,50)
		holder.BackgroundColor3 = Color3.fromRGB(25,25,25)
		holder.BorderSizePixel = 0
		Instance.new("UICorner", holder).CornerRadius = UDim.new(0,8)

		local label = Instance.new("TextLabel", holder)
		label.Text = text
		label.Size = UDim2.new(0.6,0,0.5,0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.new(1,1,1)
		label.TextXAlignment = Enum.TextXAlignment.Left

		local valueLabel = Instance.new("TextLabel", holder)
		valueLabel.Size = UDim2.new(0.4,-10,0.5,0)
		valueLabel.Position = UDim2.new(0.6,10,0,0)
		valueLabel.BackgroundTransparency = 1
		valueLabel.TextColor3 = Color3.fromRGB(0,170,255)
		valueLabel.TextXAlignment = Enum.TextXAlignment.Right

		local bar = Instance.new("Frame", holder)
		bar.Size = UDim2.new(1,-20,0,6)
		bar.Position = UDim2.new(0,10,1,-15)
		bar.BackgroundColor3 = Color3.fromRGB(40,40,40)
		Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

		local fill = Instance.new("Frame", bar)
		fill.BackgroundColor3 = Color3.fromRGB(0,170,255)
		Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)

		local current = math.clamp(default or min, min, max)

		local function setValue(val)
			if type(val) ~= "number" then return end
			current = math.clamp(val, min, max)
			local percent = (current - min) / (max - min)
			fill.Size = UDim2.new(percent,0,1,0)
			valueLabel.Text = tostring(math.floor(current)).." / " ..tostring(max)

			if callback then
				callback(current)
			end
		end

		setValue(current)

		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then

				local function update(x)
					local percent = math.clamp((x - bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
					local value = min + (max - min) * percent
					setValue(value)
				end

				update(input.Position.X)

				local move, up
				move = UIS.InputChanged:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseMovement then
						update(i.Position.X)
					end
				end)

				up = UIS.InputEnded:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then
						move:Disconnect()
						up:Disconnect()
					end
				end)
			end
		end)

		return {
			Set = setValue,
			Get = function() return current end
		}
	end

	function tab:AddInput(text, callback)
		local box = Instance.new("TextBox", tabFrame)
		box.Size = UDim2.new(1,-10,0,35)
		box.PlaceholderText = text
		box.BackgroundColor3 = Color3.fromRGB(25,25,25)
		box.TextColor3 = Color3.new(1,1,1)
		box.BorderSizePixel = 0
		box.Text = ""
		Instance.new("UICorner", box).CornerRadius = UDim.new(0,8)

		table.insert(UI.Elements, {
			Instance = box,
			Name = text:lower(),
			Tab = tabFrame
		})

		box.FocusLost:Connect(function()
			if callback then callback(box.Text) end
		end)
	end

	table.insert(UI.Tabs, tab)
	return tab
end

