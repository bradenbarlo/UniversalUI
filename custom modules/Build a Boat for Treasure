return function(UI)
	local TeleportService = game:GetService("TeleportService")

	local places = {537413528,1930665568,1930863474,1930866268}

	local babftTab = UI:AddTab("Build a Boat")

	babftTab:AddLabel("Build a Boat for Treasure", {
		Alignment = "center",
		Size = 25,
		Bold = true,
		Color = Color3.fromRGB(255, 255, 255)
	})

	local placeDrop = babftTab:AddDropdown("Places")

	placeDrop:AddButton("Build A Boat For Treasure", function()
		TeleportService:Teleport(places[1])
	end)
	placeDrop:AddButton("The Secret Place", function()
		TeleportService:Teleport(places[2])
	end)
	placeDrop:AddButton("Inner Cloud", function()
		TeleportService:Teleport(places[3])
	end)
	placeDrop:AddButton("Winter Place", function()
		TeleportService:Teleport(places[4])
	end)
end
